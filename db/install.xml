<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="admin/tool/coursedriftdetector/db"
       VERSION="2024111500"
       COMMENT="XMLDB file for Moodle tool_coursedriftdetector">

  <TABLES>
    <TABLE NAME="tool_coursedriftdetector_drift"
           COMMENT="Stores aggregated course drift snapshots">

      <FIELDS>
        <FIELD NAME="id"
               TYPE="int"
               LENGTH="10"
               NOTNULL="true"
               UNSIGNED="true"
               SEQUENCE="true"
               COMMENT="Primary key"/>

        <FIELD NAME="courseid"
               TYPE="int"
               LENGTH="10"
               NOTNULL="true"
               UNSIGNED="true"
               COMMENT="ID of the course this snapshot belongs to"/>

        <FIELD NAME="drift_score"
               TYPE="int"
               LENGTH="1"
               NOTNULL="true"
               UNSIGNED="true"
               DEFAULT="0"
               COMMENT="Calculated drift score (0=Low, 1=Medium, 2=High)"/>

        <FIELD NAME="change_count"
               TYPE="int"
               LENGTH="10"
               NOTNULL="true"
               UNSIGNED="true"
               DEFAULT="0"
               COMMENT="Number of detected changes for this snapshot"/>

        <FIELD NAME="last_analyzed"
               TYPE="int"
               LENGTH="10"
               NOTNULL="true"
               UNSIGNED="true"
               DEFAULT="0"
               COMMENT="Timestamp of last analysis"/>

        <FIELD NAME="summary"
               TYPE="text"
               NOTNULL="false"
               COMMENT="JSON summary of detected changes"/>

        <FIELD NAME="timecreated"
               TYPE="int"
               LENGTH="10"
               NOTNULL="true"
               UNSIGNED="true"
               DEFAULT="0"
               COMMENT="Record creation time"/>

        <FIELD NAME="timemodified"
               TYPE="int"
               LENGTH="10"
               NOTNULL="true"
               UNSIGNED="true"
               DEFAULT="0"
               COMMENT="Last modification time"/>
      </FIELDS>

      <KEYS>
        <KEY NAME="primary"
             TYPE="primary"
             FIELDS="id"/>

        <KEY NAME="courseid_fk"
             TYPE="foreign"
             FIELDS="courseid"
             REFTABLE="course"
             REFFIELDS="id"/>
      </KEYS>

      <INDEXES>
        <INDEX NAME="idx_courseid"
               FIELDS="courseid"/>

        <INDEX NAME="idx_lastanalyzed"
               FIELDS="last_analyzed"/>
      </INDEXES>

    </TABLE>
  </TABLES>
</XMLDB>
